<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fanconnect | Media Management in Barcelona</title>
<meta name="description" content="Fanconnect is a media management studio in Barcelona helping creators, artists and brands grow their audience.">
<style>
:root{
  --bg:#0b0b14; --card:#14142a; --text:#f2f2f8; --muted:#a3a3bd;
  --a:#ff3d81; --b:#7a5cff; --c:#22d3ee; --line:rgba(255,255,255,.08);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
a{color:inherit;text-decoration:none}
.wrap{max-width:1100px;margin:0 auto;padding:0 22px}
.grad{background:linear-gradient(90deg,var(--a),var(--b),var(--c));-webkit-background-clip:text;background-clip:text;color:transparent}

/* NAV */
header{position:sticky;top:0;z-index:20;backdrop-filter:blur(14px);background:rgba(11,11,20,.7);border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;height:66px}
.logo{font-weight:800;font-size:1.35rem;letter-spacing:-.5px}
nav ul{display:flex;gap:26px;list-style:none;font-size:.95rem;color:var(--muted)}
nav ul a:hover{color:var(--text)}
@media(max-width:700px){nav ul{display:none}}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;font-weight:600;border:0;cursor:pointer;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:linear-gradient(90deg,var(--a),var(--b));color:#fff;box-shadow:0 10px 30px rgba(122,92,255,.35)}
.btn-ghost{border:1px solid var(--line);background:rgba(255,255,255,.03)}
.btn-wa{background:#25d366;color:#06220f;box-shadow:0 10px 30px rgba(37,211,102,.3)}

/* HERO */
.hero{position:relative;padding:110px 0 90px;overflow:hidden;text-align:center}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;filter:blur(90px);opacity:.45;z-index:0}
.hero::before{width:420px;height:420px;background:var(--b);top:-120px;left:-100px}
.hero::after{width:380px;height:380px;background:var(--a);bottom:-140px;right:-80px}
.hero .wrap{position:relative;z-index:1}
.tag{display:inline-block;padding:6px 16px;border:1px solid var(--line);border-radius:999px;font-size:.82rem;color:var(--muted);margin-bottom:24px;background:rgba(255,255,255,.04)}
h1{font-size:clamp(2.4rem,6.5vw,4.6rem);line-height:1.05;letter-spacing:-2px;font-weight:800}
.hero p{max-width:620px;margin:22px auto 34px;color:var(--muted);font-size:1.1rem}
.cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

/* STATS */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin-top:70px}
.stat{padding:22px;border-radius:18px;background:var(--card);border:1px solid var(--line)}
.stat b{display:block;font-size:2rem;font-weight:800}
.stat span{color:var(--muted);font-size:.88rem}
.note{font-size:.75rem;color:var(--muted);margin-top:14px;opacity:.7}

/* SECTIONS */
section{padding:90px 0}
.eyebrow{color:var(--c);font-size:.8rem;text-transform:uppercase;letter-spacing:2px;font-weight:700}
h2{font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-1px;margin:10px 0 18px;line-height:1.15}
.lead{color:var(--muted);max-width:640px}

.about{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}
@media(max-width:800px){.about{grid-template-columns:1fr}}
.photo{aspect-ratio:4/3;border-radius:24px;border:1px solid var(--line);position:relative;overflow:hidden;
